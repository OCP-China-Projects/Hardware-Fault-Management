@@ -33,3 +33,19 @@
 &ram0 {
 	reg = <0x80000000 0x10000000>;   /* 256 MiB */
 };
+
+/*
+ * RISC-V RERI (RAS Error-record Register Interface) error bank, provided by
+ * the sifive_u RERI QEMU device (patch 0012) at 0x10080000. Its abstract RAS
+ * signal is wired to PLIC source 50. Used by the error-injection shell and
+ * the RAS handler to demonstrate the hardware fault -> PLDM reporting path.
+ */
+&{/soc} {
+	reri0: reri@10080000 {
+		compatible = "sifive,reri";
+		reg = <0x10080000 0x80>;
+		interrupt-parent = <&plic>;
+		interrupts = <50 1>;
+		status = "okay";
+	};
+};
