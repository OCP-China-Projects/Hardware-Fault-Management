diff --git a/samples/subsys/pmci/pldm/serial_bridge/boards/hifive_unleashed_fu540_u54.overlay b/samples/subsys/pmci/pldm/serial_bridge/boards/hifive_unleashed_fu540_u54.overlay
new file mode 100644
index 00000000000..49db00d53f3
--- /dev/null
+++ b/samples/subsys/pmci/pldm/serial_bridge/boards/hifive_unleashed_fu540_u54.overlay
@@ -0,0 +1,35 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * Enable the second SiFive UART (uart1) as the MCTP-over-serial link.
+ * uart0 remains the Zephyr console/shell. On QEMU's sifive_u machine the
+ * second "-serial" backend is wired to uart1, which we point at a unix
+ * socket shared with the OpenBMC QEMU instance.
+ */
+
+&uart1 {
+	status = "okay";
+	current-speed = <115200>;
+};
+
+/*
+ * Boot on QEMU's sifive_u machine. The stock fu540 devicetree pins
+ * zephyr,sram to l2lim (0x08000000), which QEMU's sifive_u model does not
+ * implement, so images linked there never fetch. Redirect sram to ram0
+ * (DDR at 0x80000000) and shrink it to 256 MiB to match `qemu -m 256`
+ * (the stock 3.75 GiB size lets the heap/stacks run off the end of the
+ * QEMU-provided RAM and trips a Store/AMO access fault).
+ */
+/ {
+	chosen {
+		zephyr,sram = &ram0;
+	};
+};
+
+&ram0 {
+	reg = <0x80000000 0x10000000>;   /* 256 MiB */
+};
