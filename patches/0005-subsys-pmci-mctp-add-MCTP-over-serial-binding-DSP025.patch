diff --git a/subsys/pmci/mctp/mctp_serial.c b/subsys/pmci/mctp/mctp_serial.c
new file mode 100644
index 00000000000..01ba631046a
--- /dev/null
+++ b/subsys/pmci/mctp/mctp_serial.c
@@ -0,0 +1,274 @@
+/*
+ * Copyright (c) 2024 Intel Corporation
+ * Copyright (c) 2026 OCP HFM prototype
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * MCTP-over-serial (DMTF DSP0253) binding driven over the interrupt-driven
+ * UART API. The framing is identical to the async mctp_uart binding; only the
+ * I/O path differs so this can run on controllers without async/DMA support.
+ */
+
+#include <zephyr/sys/__assert.h>
+#include <zephyr/kernel.h>
+#include <zephyr/drivers/uart.h>
+#include <zephyr/sys/ring_buffer.h>
+#include <zephyr/pmci/mctp/mctp_serial.h>
+#include <crc-16-ccitt.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(mctp_serial, CONFIG_MCTP_LOG_LEVEL);
+
+#define MCTP_SERIAL_REVISION     0x01
+#define MCTP_SERIAL_FRAMING_FLAG 0x7e
+#define MCTP_SERIAL_ESCAPE       0x7d
+
+struct mctp_serial_header {
+	uint8_t flag;
+	uint8_t revision;
+	uint8_t len;
+};
+
+struct mctp_serial_trailer {
+	uint8_t fcs_msb;
+	uint8_t fcs_lsb;
+	uint8_t flag;
+};
+
+static inline struct mctp_binding_serial *binding_to_serial(struct mctp_binding *b)
+{
+	return (struct mctp_binding_serial *)b;
+}
+
+static void mctp_serial_finish_pkt(struct mctp_binding_serial *serial, bool valid)
+{
+	struct mctp_pktbuf *pkt = serial->rx_pkt;
+
+	if (valid) {
+		__ASSERT_NO_MSG(pkt);
+		mctp_bus_rx(&serial->binding, pkt);
+	}
+
+	serial->rx_pkt = NULL;
+}
+
+static void mctp_serial_start_pkt(struct mctp_binding_serial *serial, uint8_t len)
+{
+	__ASSERT_NO_MSG(serial->rx_pkt == NULL);
+
+	serial->rx_pkt = mctp_pktbuf_alloc(&serial->binding, len);
+
+	__ASSERT_NO_MSG(serial->rx_pkt);
+}
+
+static size_t mctp_serial_pkt_escape(struct mctp_pktbuf *pkt, uint8_t *buf)
+{
+	uint8_t total_len;
+	uint8_t *p;
+	int i, j;
+
+	total_len = pkt->end - pkt->mctp_hdr_off;
+
+	p = (void *)mctp_pktbuf_hdr(pkt);
+
+	for (i = 0, j = 0; i < total_len; i++, j++) {
+		uint8_t c = p[i];
+
+		if (c == MCTP_SERIAL_FRAMING_FLAG || c == MCTP_SERIAL_ESCAPE) {
+			if (buf) {
+				buf[j] = MCTP_SERIAL_ESCAPE;
+			}
+			j++;
+			c ^= 0x20;
+		}
+		if (buf) {
+			buf[j] = c;
+		}
+	}
+
+	return j;
+}
+
+/*
+ * Per-byte DSP0253 decode state machine. Mirrors mctp_uart_consume().
+ */
+static void mctp_serial_consume(struct mctp_binding_serial *serial, uint8_t c)
+{
+	struct mctp_pktbuf *pkt = serial->rx_pkt;
+	bool valid = false;
+
+	__ASSERT_NO_MSG(!pkt == (serial->rx_state == MCTP_SERIAL_STATE_WAIT_SYNC_START ||
+				 serial->rx_state == MCTP_SERIAL_STATE_WAIT_REVISION ||
+				 serial->rx_state == MCTP_SERIAL_STATE_WAIT_LEN));
+
+	switch (serial->rx_state) {
+	case MCTP_SERIAL_STATE_WAIT_SYNC_START:
+		if (c != MCTP_SERIAL_FRAMING_FLAG) {
+			if (pkt) {
+				mctp_serial_finish_pkt(serial, false);
+			}
+		} else {
+			serial->rx_state = MCTP_SERIAL_STATE_WAIT_REVISION;
+		}
+		break;
+	case MCTP_SERIAL_STATE_WAIT_REVISION:
+		if (c == MCTP_SERIAL_REVISION) {
+			serial->rx_state = MCTP_SERIAL_STATE_WAIT_LEN;
+			serial->rx_fcs_calc = crc_16_ccitt_byte(FCS_INIT_16, c);
+		} else if (c == MCTP_SERIAL_FRAMING_FLAG) {
+			/* stray trailing flag: stay put and resync */
+		} else {
+			serial->rx_state = MCTP_SERIAL_STATE_WAIT_SYNC_START;
+		}
+		break;
+	case MCTP_SERIAL_STATE_WAIT_LEN:
+		if (c > serial->binding.pkt_size || c < sizeof(struct mctp_hdr)) {
+			serial->rx_state = MCTP_SERIAL_STATE_WAIT_SYNC_START;
+		} else {
+			mctp_serial_start_pkt(serial, 0);
+			pkt = serial->rx_pkt;
+			serial->rx_exp_len = c;
+			serial->rx_state = MCTP_SERIAL_STATE_DATA;
+			serial->rx_fcs_calc = crc_16_ccitt_byte(serial->rx_fcs_calc, c);
+		}
+		break;
+	case MCTP_SERIAL_STATE_DATA:
+		if (c == MCTP_SERIAL_ESCAPE) {
+			serial->rx_state = MCTP_SERIAL_STATE_DATA_ESCAPED;
+		} else {
+			mctp_pktbuf_push(pkt, &c, 1);
+			serial->rx_fcs_calc = crc_16_ccitt_byte(serial->rx_fcs_calc, c);
+			if (pkt->end - pkt->mctp_hdr_off == serial->rx_exp_len) {
+				serial->rx_state = MCTP_SERIAL_STATE_WAIT_FCS1;
+			}
+		}
+		break;
+	case MCTP_SERIAL_STATE_DATA_ESCAPED:
+		c ^= 0x20;
+		mctp_pktbuf_push(pkt, &c, 1);
+		serial->rx_fcs_calc = crc_16_ccitt_byte(serial->rx_fcs_calc, c);
+		if (pkt->end - pkt->mctp_hdr_off == serial->rx_exp_len) {
+			serial->rx_state = MCTP_SERIAL_STATE_WAIT_FCS1;
+		} else {
+			serial->rx_state = MCTP_SERIAL_STATE_DATA;
+		}
+		break;
+	case MCTP_SERIAL_STATE_WAIT_FCS1:
+		serial->rx_fcs = c << 8;
+		serial->rx_state = MCTP_SERIAL_STATE_WAIT_FCS2;
+		break;
+	case MCTP_SERIAL_STATE_WAIT_FCS2:
+		serial->rx_fcs |= c;
+		serial->rx_state = MCTP_SERIAL_STATE_WAIT_SYNC_END;
+		break;
+	case MCTP_SERIAL_STATE_WAIT_SYNC_END:
+		if (serial->rx_fcs == serial->rx_fcs_calc) {
+			valid = (c == MCTP_SERIAL_FRAMING_FLAG);
+			if (!valid) {
+				LOG_DBG("missing end frame marker");
+			}
+		} else {
+			valid = false;
+			LOG_DBG("invalid fcs : 0x%04x, expect 0x%04x", serial->rx_fcs,
+				serial->rx_fcs_calc);
+		}
+
+		mctp_serial_finish_pkt(serial, valid);
+		serial->rx_state = MCTP_SERIAL_STATE_WAIT_SYNC_START;
+		break;
+	}
+}
+
+/*
+ * Note on the SiFive UART: its irq_is_pending()/irq_tx_ready() report the raw
+ * hardware condition (TXWM is asserted whenever the TX FIFO is below the
+ * watermark, i.e. almost always). Looping on irq_is_pending() would therefore
+ * never terminate, and honouring irq_tx_ready() unconditionally would keep
+ * re-triggering the TX path. So this ISR runs a single pass and only touches
+ * the TX FIFO while we have queued data (tx_active).
+ */
+static void mctp_serial_isr(const struct device *dev, void *user_data)
+{
+	struct mctp_binding_serial *serial = user_data;
+	uint8_t byte;
+
+	uart_irq_update(dev);
+
+	while (uart_irq_rx_ready(dev)) {
+		if (uart_fifo_read(dev, &byte, 1) == 1) {
+			mctp_serial_consume(serial, byte);
+		}
+	}
+
+	if (serial->tx_active && uart_irq_tx_ready(dev)) {
+		if (ring_buf_get(&serial->tx_rb, &byte, 1) == 1) {
+			uart_fifo_fill(dev, &byte, 1);
+		} else {
+			uart_irq_tx_disable(dev);
+			serial->tx_active = false;
+		}
+	}
+}
+
+void mctp_serial_start_rx(struct mctp_binding_serial *serial)
+{
+	ring_buf_init(&serial->tx_rb, sizeof(serial->tx_rb_buf), serial->tx_rb_buf);
+	serial->tx_active = false;
+	uart_irq_rx_disable(serial->dev);
+	uart_irq_tx_disable(serial->dev);
+	uart_irq_callback_user_data_set(serial->dev, mctp_serial_isr, serial);
+	uart_irq_rx_enable(serial->dev);
+}
+
+int mctp_serial_tx(struct mctp_binding *b, struct mctp_pktbuf *pkt)
+{
+	struct mctp_binding_serial *serial = binding_to_serial(b);
+	struct mctp_serial_header *hdr;
+	struct mctp_serial_trailer *tlr;
+	uint8_t *buf;
+	size_t len;
+	uint16_t fcs;
+
+	len = mctp_pktbuf_size(pkt);
+
+	hdr = (void *)serial->tx_buf;
+	hdr->flag = MCTP_SERIAL_FRAMING_FLAG;
+	hdr->revision = MCTP_SERIAL_REVISION;
+	hdr->len = len;
+
+	fcs = crc_16_ccitt(FCS_INIT_16, (const uint8_t *)hdr + 1, 2);
+	fcs = crc_16_ccitt(fcs, (const uint8_t *)mctp_pktbuf_hdr(pkt), len);
+
+	buf = (void *)(hdr + 1);
+
+	len = mctp_serial_pkt_escape(pkt, NULL);
+	if (len + sizeof(*hdr) + sizeof(*tlr) > sizeof(serial->tx_buf)) {
+		return -EMSGSIZE;
+	}
+
+	mctp_serial_pkt_escape(pkt, buf);
+	buf += len;
+
+	tlr = (void *)buf;
+	tlr->flag = MCTP_SERIAL_FRAMING_FLAG;
+	tlr->fcs_msb = fcs >> 8;
+	tlr->fcs_lsb = fcs & 0xff;
+
+	len += sizeof(*hdr) + sizeof(*tlr);
+
+	if (ring_buf_put(&serial->tx_rb, serial->tx_buf, len) != len) {
+		LOG_ERR("tx ring buffer full, dropping packet");
+		return -ENOMEM;
+	}
+
+	serial->tx_active = true;
+	uart_irq_tx_enable(serial->dev);
+
+	return 0;
+}
+
+int mctp_serial_start(struct mctp_binding *binding)
+{
+	mctp_binding_set_tx_enabled(binding, true);
+	return 0;
+}
