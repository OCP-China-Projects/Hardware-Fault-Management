diff --git a/include/zephyr/pmci/mctp/mctp_serial.h b/include/zephyr/pmci/mctp/mctp_serial.h
new file mode 100644
index 00000000000..4e35a248ad5
--- /dev/null
+++ b/include/zephyr/pmci/mctp/mctp_serial.h
@@ -0,0 +1,94 @@
+/*
+ * Copyright (c) 2024 Intel Corporation
+ * Copyright (c) 2026 OCP HFM prototype
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ */
+
+#ifndef ZEPHYR_MCTP_SERIAL_H_
+#define ZEPHYR_MCTP_SERIAL_H_
+
+#include <stdint.h>
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <zephyr/sys/ring_buffer.h>
+#include <libmctp.h>
+
+/**
+ * @brief An MCTP binding for Zephyr's interrupt-driven UART interface.
+ *
+ * Same MCTP-over-serial framing (DMTF DSP0253) as @ref mctp_binding_uart, but
+ * driven over the interrupt-driven UART API (uart_fifo_read / uart_fifo_fill)
+ * instead of the async API. This lets the binding run on UART controllers that
+ * implement only the interrupt-driven API and lack async/DMA support (for
+ * example the SiFive UART on QEMU's sifive_u machine).
+ */
+struct mctp_binding_serial {
+	/** @cond INTERNAL_HIDDEN */
+	struct mctp_binding binding;
+	const struct device *dev;
+
+	/* receive state machine */
+	struct mctp_pktbuf *rx_pkt;
+	uint8_t rx_exp_len;
+	uint16_t rx_fcs;
+	uint16_t rx_fcs_calc;
+	enum {
+		MCTP_SERIAL_STATE_WAIT_SYNC_START,
+		MCTP_SERIAL_STATE_WAIT_REVISION,
+		MCTP_SERIAL_STATE_WAIT_LEN,
+		MCTP_SERIAL_STATE_DATA,
+		MCTP_SERIAL_STATE_DATA_ESCAPED,
+		MCTP_SERIAL_STATE_WAIT_FCS1,
+		MCTP_SERIAL_STATE_WAIT_FCS2,
+		MCTP_SERIAL_STATE_WAIT_SYNC_END,
+	} rx_state;
+
+	/* tx ring buffer drained by the UART tx interrupt */
+	struct ring_buf tx_rb;
+	uint8_t tx_rb_buf[512];
+	/* staging buffer used to frame one packet before pushing to tx_rb */
+	uint8_t tx_buf[256];
+	/* set while the tx interrupt is enabled and draining tx_rb */
+	bool tx_active;
+
+	/** INTERNAL_HIDDEN @endcond */
+};
+
+/**
+ * @brief Enable UART RX/TX interrupts and start receiving MCTP messages.
+ *
+ * @param serial MCTP serial binding
+ */
+void mctp_serial_start_rx(struct mctp_binding_serial *serial);
+
+/** @cond INTERNAL_HIDDEN */
+int mctp_serial_start(struct mctp_binding *binding);
+int mctp_serial_tx(struct mctp_binding *binding, struct mctp_pktbuf *pkt);
+/** INTERNAL_HIDDEN @endcond */
+
+/**
+ * @brief Statically define an MCTP bus binding for an interrupt-driven UART.
+ *
+ * @param _name Symbolic name of the bus binding variable
+ * @param _dev UART device (const struct device *)
+ */
+#define MCTP_SERIAL_DT_DEFINE(_name, _dev)                                                         \
+	struct mctp_binding_serial _name = {                                                       \
+		.binding =                                                                         \
+			{                                                                          \
+				.name = STRINGIFY(_name),                                          \
+				.version = 1,                                                      \
+				.pkt_size = MCTP_PACKET_SIZE(MCTP_BTU),                            \
+				.pkt_header = 0,                                                    \
+				.pkt_trailer = 0,                                                  \
+				.start = mctp_serial_start,                                        \
+				.tx = mctp_serial_tx,                                              \
+			},                                                                         \
+		.dev = _dev,                                                                       \
+		.rx_state = MCTP_SERIAL_STATE_WAIT_SYNC_START,                                     \
+		.rx_pkt = NULL,                                                                    \
+	}
+
+#endif /* ZEPHYR_MCTP_SERIAL_H_ */
