diff --git a/samples/subsys/pmci/pldm/serial_bridge/src/main.c b/samples/subsys/pmci/pldm/serial_bridge/src/main.c
new file mode 100644
index 00000000000..f84440013d5
--- /dev/null
+++ b/samples/subsys/pmci/pldm/serial_bridge/src/main.c
@@ -0,0 +1,84 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * PLDM Type 0 endpoint over an MCTP-over-serial (DSP0253) link.
+ *
+ * This runs on a Zephyr QEMU instance whose second UART is bridged (via a
+ * host unix socket) to an OpenBMC QEMU instance running mctpd + pldmd. The
+ * BMC is the MCTP bus owner (EID 8); this endpoint answers as EID 18.
+ *
+ * The node registers the PLDM Type 0 responder so the BMC's pldmtool can run
+ *   pldmtool base GetTID / GetPLDMTypes / GetPLDMVersion / GetPLDMCommands
+ * against it. It then drains the serial link in the main loop.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <zephyr/logging/log.h>
+
+#include <libmctp.h>
+
+#include <zephyr/pmci/mctp/mctp_serial.h>
+#include <zephyr/pmci/pldm/pldm.h>
+#include <zephyr/pmci/pldm/pldm_base.h>
+
+LOG_MODULE_REGISTER(serial_bridge, LOG_LEVEL_INF);
+
+/* MCTP endpoint IDs: BMC bus owner = 8, this Zephyr endpoint = 18. */
+#define LOCAL_EID 18
+#define BMC_EID   8
+
+static struct mctp *mctp_ctx;
+static struct pldm_ctx pldm;
+
+MCTP_SERIAL_DT_DEFINE(mctp_link, DEVICE_DT_GET(DT_NODELABEL(uart1)));
+
+int main(void)
+{
+	int rc;
+
+	LOG_INF("PLDM serial bridge: EID %d on %s (peer BMC EID %d)", LOCAL_EID,
+		CONFIG_BOARD_TARGET, BMC_EID);
+
+	mctp_set_alloc_ops(malloc, free, realloc);
+
+	mctp_ctx = mctp_init();
+	if (mctp_ctx == NULL) {
+		LOG_ERR("mctp_init failed");
+		return -1;
+	}
+
+	rc = mctp_register_bus(mctp_ctx, &mctp_link.binding, LOCAL_EID);
+	if (rc != 0) {
+		LOG_ERR("mctp_register_bus rc=%d", rc);
+		return -1;
+	}
+
+	rc = pldm_ctx_init(&pldm, mctp_ctx, LOCAL_EID);
+	if (rc != 0) {
+		LOG_ERR("pldm_ctx_init rc=%d", rc);
+		return -1;
+	}
+
+	rc = pldm_base_responder_register(&pldm);
+	if (rc != 0) {
+		LOG_ERR("pldm_base_responder_register rc=%d", rc);
+		return -1;
+	}
+
+	/* Enable UART interrupts and start feeding the DSP0253 decoder. */
+	mctp_serial_start_rx(&mctp_link);
+
+	LOG_INF("Type 0 responder ready; waiting for PLDM requests from the BMC");
+
+	while (true) {
+		k_sleep(K_FOREVER);
+	}
+
+	return 0;
+}
