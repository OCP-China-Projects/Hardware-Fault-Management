+++ b/samples/subsys/pmci/pldm/serial_bridge/src/reri_ras.h
@@ -0,0 +1,50 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * RISC-V RERI RAS handler public interface.
+ */
+
+#ifndef APP_RERI_RAS_H_
+#define APP_RERI_RAS_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/** Last RAS error decoded from the RERI bank. */
+struct reri_ras_event {
+	bool valid;         /**< a RAS error has been latched          */
+	unsigned int record;/**< RERI record index                     */
+	uint64_t status;    /**< raw status_i                          */
+	uint64_t addr_info; /**< raw addr_info_i                       */
+	uint8_t ec;         /**< status_i.ec error code                */
+	int severity;       /**< RERI_PRI_INFO / _LOW / _HIGH          */
+};
+
+/**
+ * @brief Connect and enable the RERI RAS interrupt.
+ *
+ * @return 0 on success, -ENODEV if the reri0 node is not enabled.
+ */
+int reri_ras_init(void);
+
+/**
+ * @brief Register the RAS severity numeric sensor with the PLDM Type 2
+ *        responder. Call before pldm_platform_responder_register().
+ *
+ * @return 0 on success, negative errno otherwise.
+ */
+int reri_ras_register_sensor(void);
+
+/**
+ * @brief Copy the last latched RAS event.
+ *
+ * @return the current latched severity (0 if none).
+ */
+int reri_ras_get_event(struct reri_ras_event *out);
+
+/** @brief Current latched RAS severity (0 none / 1 low / 2 high). */
+int reri_ras_severity_now(void);
+
+#endif /* APP_RERI_RAS_H_ */
