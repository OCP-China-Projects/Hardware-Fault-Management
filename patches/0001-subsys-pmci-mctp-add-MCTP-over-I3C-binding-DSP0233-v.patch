diff --git a/include/zephyr/pmci/mctp/mctp_i3c.h b/include/zephyr/pmci/mctp/mctp_i3c.h
new file mode 100644
index 00000000000..5bd6db4f920
--- /dev/null
+++ b/include/zephyr/pmci/mctp/mctp_i3c.h
@@ -0,0 +1,108 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_MCTP_I3C_H_
+#define ZEPHYR_MCTP_I3C_H_
+
+#include <stdint.h>
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <zephyr/drivers/i3c.h>
+#include <libmctp.h>
+
+/**
+ * @brief DSP0233 v1.0 — MCTP over I3C transport binding.
+ *
+ * The Zephyr guest acts as the primary I3C controller; the peer target
+ * signals a pending message via IBI (MDB = 0xAE) and the controller reads
+ * the frame back through a private I3C read.
+ */
+
+/** DSP0233 §6.1 — max frame payload including MCTP header. */
+#define MCTP_I3C_MTU CONFIG_MCTP_I3C_MTU
+
+/** DSP0233 §6.2 — Device Class Register value advertising an MCTP endpoint. */
+#define MCTP_I3C_DCR 0xCC
+
+/** DSP0233 §6.4 — Mandatory Data Byte accompanying the IBI. */
+#define MCTP_I3C_IBI_MDB 0xAE
+
+/** @cond INTERNAL_HIDDEN */
+struct mctp_binding_i3c;
+/** INTERNAL_HIDDEN @endcond */
+
+/**
+ * @brief MCTP I3C binding descriptor.
+ *
+ * Wraps the generic libmctp binding with I3C-specific state: the controller
+ * device, the peer target descriptor, RX/TX staging buffers and the RX
+ * work item that runs the private read out of interrupt context.
+ */
+struct mctp_binding_i3c {
+	/** @cond INTERNAL_HIDDEN */
+	struct mctp_binding binding;
+
+	/** I3C controller device this binding operates on. */
+	const struct device *i3c_dev;
+
+	/** Peer target device descriptor (the MCTP endpoint). */
+	struct i3c_device_desc *target;
+
+	/** Staging buffer used to build the outgoing frame (MCTP hdr + payload + PEC). */
+	uint8_t tx_buf[MCTP_I3C_MTU + 1];
+
+	/** Staging buffer used to receive the incoming frame. */
+	uint8_t rx_buf[MCTP_I3C_MTU + 1];
+
+	/** Length of the last read into @c rx_buf. */
+	uint8_t rx_len;
+
+	/** Deferred work handling the private read after an IBI. */
+	struct k_work rx_work;
+
+	/** Result of the last transmission. */
+	int tx_res;
+
+	/** Result of the last reception. */
+	int rx_res;
+	/** INTERNAL_HIDDEN @endcond */
+};
+
+/** @cond INTERNAL_HIDDEN */
+int  mctp_i3c_start(struct mctp_binding *binding);
+int  mctp_i3c_tx(struct mctp_binding *binding, struct mctp_pktbuf *pkt);
+int  mctp_i3c_ibi_cb(struct i3c_device_desc *target,
+		     struct i3c_ibi_payload *payload);
+/** INTERNAL_HIDDEN @endcond */
+
+/**
+ * @brief Statically define an MCTP I3C bus binding.
+ *
+ * @param _name  Symbolic name of the binding variable.
+ * @param _i3c   Pointer to the I3C controller @c device.
+ * @param _tgt   Pointer to a pre-populated @ref i3c_device_desc for the peer
+ *               MCTP endpoint. Its @c ibi_cb field is overwritten by
+ *               @ref mctp_i3c_start.
+ */
+#define MCTP_I3C_DT_DEFINE(_name, _i3c, _tgt)                                      \
+	struct mctp_binding_i3c _name = {                                          \
+		.binding = {                                                       \
+			.name = STRINGIFY(_name),                                  \
+			.version = 1,                                              \
+			.pkt_size = MCTP_PACKET_SIZE(MCTP_BTU),                    \
+			.pkt_header = 0,                                           \
+			.pkt_trailer = 0,                                          \
+			.start = mctp_i3c_start,                                   \
+			.tx = mctp_i3c_tx,                                         \
+		},                                                                 \
+		.i3c_dev = (_i3c),                                                 \
+		.target = (_tgt),                                                  \
+		.rx_len = 0,                                                       \
+		.tx_res = 0,                                                       \
+		.rx_res = 0,                                                       \
+	}
+
+#endif /* ZEPHYR_MCTP_I3C_H_ */
