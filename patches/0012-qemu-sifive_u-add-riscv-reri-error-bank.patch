     object_initialize_child(obj, "otp", &s->otp, TYPE_SIFIVE_U_OTP);
+    object_initialize_child(obj, "reri", &s->reri, TYPE_SIFIVE_U_RERI);
     object_initialize_child(obj, "gem", &s->gem, TYPE_CADENCE_GEM);
     object_initialize_child(obj, "gpio", &s->gpio, TYPE_SIFIVE_GPIO);
     object_initialize_child(obj, "pdma", &s->dma, TYPE_SIFIVE_PDMA);
@@ -895,6 +897,15 @@
     }
     sysbus_mmio_map(SYS_BUS_DEVICE(&s->otp), 0, memmap[SIFIVE_U_DEV_OTP].base);
 
+    /* RISC-V RERI error bank; its RAS signal is wired to the PLIC. */
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->reri), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->reri), 0,
+                    memmap[SIFIVE_U_DEV_RERI].base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->reri), 0,
+                       qdev_get_gpio_in(DEVICE(s->plic), SIFIVE_U_RERI_IRQ));
+
     qemu_configure_nic_device(DEVICE(&s->gem), true, NULL);
     object_property_set_int(OBJECT(&s->gem), "revision", GEM_REVISION,
                             &error_abort);

