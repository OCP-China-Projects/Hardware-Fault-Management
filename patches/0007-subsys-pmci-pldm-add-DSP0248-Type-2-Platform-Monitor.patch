diff --git a/subsys/pmci/pldm/pldm_base.c b/subsys/pmci/pldm/pldm_base.c
index 9fdc3ecf93b..59aa8ce58d8 100644
--- a/subsys/pmci/pldm/pldm_base.c
+++ b/subsys/pmci/pldm/pldm_base.c
@@ -33,8 +33,11 @@ LOG_MODULE_DECLARE(pldm, CONFIG_PLDM_LOG_LEVEL);
  */
 static uint8_t pldm_base_tid = CONFIG_PLDM_BASE_INITIAL_TID;
 
-/* Only PLDM_BASE (0) is supported so far. Bit N in supported_types[N/8]. */
-static const bitfield8_t base_supported_types[8] = {
+/*
+ * Bit N in supported_types[N/8] flags PLDM type N. PLDM_BASE (0) is always
+ * present; other types register themselves via pldm_base_register_type().
+ */
+static bitfield8_t base_supported_types[8] = {
 	{ .byte = (1U << PLDM_BASE) },
 	{ 0 }, { 0 }, { 0 }, { 0 }, { 0 }, { 0 }, { 0 },
 };
@@ -50,6 +53,67 @@ static const ver32_t base_version = {
 	.alpha = 0x00,
 };
 
+/*
+ * Registry of additional PLDM types (beyond Type 0) whose version and command
+ * set the base discovery commands should report. Populated by
+ * pldm_base_register_type(); typically one entry (Type 2).
+ */
+#define BASE_MAX_EXTRA_TYPES 4
+
+static struct base_extra_type {
+	bool used;
+	uint8_t type;
+	ver32_t version;
+	bitfield8_t commands[32];
+} base_extra_types[BASE_MAX_EXTRA_TYPES];
+
+static struct base_extra_type *base_find_extra_type(uint8_t type)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(base_extra_types); i++) {
+		if (base_extra_types[i].used &&
+		    base_extra_types[i].type == type) {
+			return &base_extra_types[i];
+		}
+	}
+	return NULL;
+}
+
+int pldm_base_register_type(uint8_t pldm_type, const ver32_t *version,
+			    const bitfield8_t commands[32])
+{
+	struct base_extra_type *slot;
+
+	if (version == NULL || commands == NULL) {
+		return -EINVAL;
+	}
+	if (pldm_type == PLDM_BASE || pldm_type >= PLDM_MAX_TYPES) {
+		return -EINVAL;
+	}
+
+	slot = base_find_extra_type(pldm_type);
+	if (slot == NULL) {
+		for (size_t i = 0; i < ARRAY_SIZE(base_extra_types); i++) {
+			if (!base_extra_types[i].used) {
+				slot = &base_extra_types[i];
+				break;
+			}
+		}
+	}
+	if (slot == NULL) {
+		return -ENOSPC;
+	}
+
+	slot->used = true;
+	slot->type = pldm_type;
+	slot->version = *version;
+	memcpy(slot->commands, commands, sizeof(slot->commands));
+
+	/* Advertise the type in GetPLDMTypes. */
+	base_supported_types[pldm_type / 8].byte |= 1U << (pldm_type % 8);
+
+	return 0;
+}
+
 uint8_t pldm_base_get_tid(void)
 {
 	return pldm_base_tid;
@@ -154,12 +218,29 @@ static int handle_get_version(const struct pldm_msg *req, size_t req_len,
 	}
 
 	if (type != PLDM_BASE) {
