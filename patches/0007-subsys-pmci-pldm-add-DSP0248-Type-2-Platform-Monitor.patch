--- /dev/null
+++ b/include/zephyr/pmci/pldm/pldm_platform.h
@@ -0,0 +1,96 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_PLATFORM_H_
+#define ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_PLATFORM_H_
+
+#include <stdint.h>
+#include <zephyr/pmci/pldm/pldm.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @file
+ * @brief DSP0248 PLDM Type 2 (Platform Monitoring and Control) responder.
+ *
+ * Implements the terminus side of a small platform-monitoring surface so a
+ * management controller (e.g. OpenBMC pldmd platform-mc) can discover and
+ * poll sensors hosted by this node:
+ *   - GetPDRRepositoryInfo (0x50) / GetPDR (0x51): expose a compile-time PDR
+ *     repository holding a Terminus Locator PDR plus one Numeric Sensor PDR
+ *     per registered sensor.
+ *   - GetSensorReading (0x11): return the live value of a numeric sensor.
+ *   - GetStateSensorReadings (0x21): minimal single-field state readback.
+ *   - PlatformEventMessage (0x0a): accept and acknowledge inbound events.
+ *
+ * All encode/decode is delegated to libpldm; the PDR wire images are built
+ * here because libpldm ships no numeric-sensor PDR encoder.
+ */
+
+struct pldm_platform_sensor;
+
+/**
+ * @brief Read callback returning the present value of a numeric sensor.
+ *
+ * @param sensor   The sensor being read.
+ * @param reading  Present value (raw, signed 32-bit). The advertised PDR
+ *                 resolution/offset describe how to convert it to a unit.
+ *
+ * @return 0 on success; negative errno to report the sensor as failed.
+ */
+typedef int (*pldm_platform_read_fn)(const struct pldm_platform_sensor *sensor,
+				     int32_t *reading);
+
+/**
+ * @brief Description of a numeric sensor exposed over PLDM Type 2.
+ *
+ * The caller populates one of these (typically as a static const) and passes
+ * it to @ref pldm_platform_add_numeric_sensor. The value is copied into the
+ * module's registry, so the caller's struct need not outlive the call.
+ */
+struct pldm_platform_sensor {
+	uint16_t sensor_id;	    /**< Sensor ID, unique per terminus. */
+	uint16_t entity_type;	    /**< DSP0249 entity type. */
+	uint16_t entity_instance;   /**< Entity instance number. */
+	uint8_t base_unit;	    /**< enum pldm_sensor_units, e.g. degrees C. */
+	int8_t unit_modifier;	    /**< Power-of-ten applied to the reading. */
+	pldm_platform_read_fn read; /**< Live-value callback. */
+};
+
+/**
+ * @brief Install the Type 2 responder into @p ctx.
+ *
+ * Registers the platform handler for PLDM_PLATFORM and announces the type,
+ * its version and command set to the Type 0 (base) responder so the base
+ * discovery commands advertise Type 2. Call after the sensors have been
+ * added, or add sensors afterwards; both orders are supported.
+ *
+ * @return 0 on success, negative errno otherwise.
+ */
+int pldm_platform_responder_register(struct pldm_ctx *ctx);
+
+/**
+ * @brief Register a numeric sensor and its Numeric Sensor PDR.
+ *
+ * @return 0 on success, -ENOSPC if the registry is full, -EINVAL on a bad
+ *         argument.
+ */
+int pldm_platform_add_numeric_sensor(const struct pldm_platform_sensor *sensor);
+
+/**
+ * @brief Override the Terminus ID reported in the Terminus Locator PDR.
+ *
+ * Defaults to the Type 0 TID (@ref pldm_base_get_tid) sampled at register time.
+ */
+void pldm_platform_set_tid(uint8_t tid);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_PLATFORM_H_ */
