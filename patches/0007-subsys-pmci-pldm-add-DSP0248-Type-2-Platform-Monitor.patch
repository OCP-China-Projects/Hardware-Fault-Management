+config PLDM_PLATFORM_MAX_SENSORS
+	int "Maximum numeric sensors exposed over PLDM Type 2"
+	depends on PLDM_TYPE_PLATFORM
+	default 4
+	range 1 32
+	help
+	  Size of the static sensor registry populated by
+	  pldm_platform_add_numeric_sensor(). One Numeric Sensor PDR is
+	  generated per registered sensor.
+
