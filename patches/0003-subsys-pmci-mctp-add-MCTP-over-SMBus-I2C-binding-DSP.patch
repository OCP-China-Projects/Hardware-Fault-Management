diff --git a/subsys/pmci/mctp/Kconfig b/subsys/pmci/mctp/Kconfig
index c6b68fa002a..42da7de4f09 100644
--- a/subsys/pmci/mctp/Kconfig
+++ b/subsys/pmci/mctp/Kconfig
@@ -43,6 +43,28 @@ config MCTP_I2C_GPIO_TARGET
 	  Build the MCTP I2C+GPIO target binding to use MCTP over Zephyr's I2C target
 	  interface and GPIO to signal writes to the bus controller.
 
+config MCTP_I2C
+	bool "MCTP over SMBus/I2C Binding (DSP0237)"
+	depends on I2C
+	help
+	  Build the standard DMTF DSP0237 MCTP-over-SMBus/I2C binding. Packets
+	  are carried as SMBus block writes (command code 0x0F) with a trailing
+	  SMBus PEC. The Zephyr guest is the bus controller for TX and registers
+	  as an I2C target to receive block writes from the peer. This binding is
+	  wire-compatible with the Linux kernel mctp-i2c driver used by OpenBMC.
+
+config MCTP_I2C_MTU
+	int "Maximum I2C MCTP packet body size (bytes)"
+	depends on MCTP_I2C
+	range 32 254
+	default 68
+	help
+	  Maximum size, in bytes, of the MCTP packet body (MCTP header plus
+	  payload) carried in one SMBus block write, excluding the command code,
+	  byte count, source address and trailing PEC. DSP0237 caps the SMBus
+	  block at 255 bytes; 68 bytes (4 B MCTP header + 64 B baseline
+	  transmission unit) is the interoperable default.
+
 config MCTP_I3C
 	bool "MCTP I3C Binding"
 	depends on I3C
diff --git a/subsys/pmci/mctp/mctp_i2c.c b/subsys/pmci/mctp/mctp_i2c.c
new file mode 100644
index 00000000000..30fe014a5c0
--- /dev/null
+++ b/subsys/pmci/mctp/mctp_i2c.c
@@ -0,0 +1,256 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * DSP0237 v1.2 — MCTP over SMBus/I2C transport binding for Zephyr.
+ *
+ * Wire frame (SMBus Block Write, command code 0x0F):
+ *
+ *   [ dest<<1|W ] [ 0x0F ] [ byte_count ] [ src<<1|1 ] [ MCTP packet ] [ PEC ]
+ *
+ * byte_count counts the source-address byte plus the MCTP packet. The PEC is
+ * an SMBus CRC-8 (poly 0x07, seed 0x00) over the destination write address
+ * and every subsequent byte up to (but not including) the PEC.
+ *
+ * TX: the guest is the bus controller and issues i2c_write() to the peer.
+ * RX: the guest is registered as an I2C target; the peer's block write is
+ *     reassembled by the target callbacks and decoded by mctp_i2c_input().
+ */
+
+#include <string.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/__assert.h>
+#include <zephyr/drivers/i2c.h>
+#include <zephyr/pmci/mctp/mctp_i2c.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(mctp_i2c, CONFIG_MCTP_LOG_LEVEL);
+
+static inline struct mctp_binding_i2c *binding_to_i2c(struct mctp_binding *b)
+{
+	return CONTAINER_OF(b, struct mctp_binding_i2c, binding);
+}
+
+/* SMBus PEC: CRC-8, poly 0x07, seed 0x00 (DSP0237 §6.3). */
+static uint8_t mctp_i2c_pec(uint8_t crc, const uint8_t *buf, size_t len)
+{
+	for (size_t i = 0; i < len; i++) {
+		crc ^= buf[i];
+		for (int b = 0; b < 8; b++) {
+			crc = (crc & 0x80) ? (uint8_t)((crc << 1) ^ 0x07)
+					   : (uint8_t)(crc << 1);
+		}
+	}
+	return crc;
+}
+
+/*
+ * Decode a fully framed block write (command code .. PEC) and, if valid, hand
+ * the embedded MCTP packet to the core. Shared by the real target-mode RX path
+ * and the loopback sample so the framing rules live in one place.
+ */
+int mctp_i2c_input(struct mctp_binding_i2c *b, const uint8_t *frame, size_t len)
+{
+	struct mctp_pktbuf *pkt;
+	uint8_t byte_count;
+	uint8_t pec, expected;
+	size_t pkt_len;
+
+	/* command code + byte count + source addr + at least an MCTP hdr + PEC */
+	if (len < MCTP_I2C_FRAME_OVERHEAD + sizeof(struct mctp_hdr)) {
+		LOG_WRN("i2c rx: short frame (%zu bytes)", len);
+		return -EBADMSG;
+	}
+
+	if (frame[0] != MCTP_I2C_COMMAND_CODE) {
+		LOG_WRN("i2c rx: bad command 0x%02x", frame[0]);
+		return -EBADMSG;
+	}
+
+	byte_count = frame[1];
+	/* byte_count covers the source-address byte + MCTP packet. */
+	if ((size_t)byte_count + 3U != len) {
+		LOG_WRN("i2c rx: byte_count %u != frame %zu", byte_count, len);
+		return -EBADMSG;
+	}
+
+	/* PEC covers dest write address + everything up to the PEC byte. */
+	uint8_t dest_wr = (uint8_t)(b->own_addr << 1);
+
+	pec = mctp_i2c_pec(0, &dest_wr, 1);
+	pec = mctp_i2c_pec(pec, frame, len - 1);
+	expected = frame[len - 1];
+	if (pec != expected) {
+		LOG_WRN("i2c rx: PEC got=0x%02x exp=0x%02x", expected, pec);
+		return -EBADMSG;
+	}
+
+	/* MCTP packet = frame minus [cmd][byte_count][src_addr] and [PEC]. */
+	pkt_len = len - MCTP_I2C_FRAME_OVERHEAD;
+
+	pkt = mctp_pktbuf_alloc(&b->binding, 0);
+	if (pkt == NULL) {
+		LOG_ERR("i2c rx: pktbuf alloc failed");
+		return -ENOMEM;
+	}
+	if (mctp_pktbuf_push(pkt, &frame[3], pkt_len) != 0) {
+		LOG_ERR("i2c rx: pktbuf push failed");
+		mctp_pktbuf_free(pkt);
+		return -ENOMEM;
+	}
+
+	mctp_bus_rx(&b->binding, pkt);
+	return 0;
+}
+
+/*
+ * I2C target callbacks. The peer controller addresses us and streams the
+ * block-write bytes (command code, byte count, source, packet, PEC) via
+ * write_received; on stop we decode the accumulated frame.
+ */
+static int mctp_i2c_target_write_requested(struct i2c_target_config *cfg)
+{
+	struct mctp_binding_i2c *b =
+		CONTAINER_OF(cfg, struct mctp_binding_i2c, target_cfg);
+
+	b->rx_idx = 0;
+	b->rx_active = true;
+	b->rx_overflow = false;
+	return 0;
+}
+
+static int mctp_i2c_target_write_received(struct i2c_target_config *cfg,
+					  uint8_t val)
+{
+	struct mctp_binding_i2c *b =
+		CONTAINER_OF(cfg, struct mctp_binding_i2c, target_cfg);
+
+	if (!b->rx_active) {
+		return 0;
+	}
+	if (b->rx_idx >= sizeof(b->rx_buf)) {
+		b->rx_overflow = true;
+		return -ENOMEM;
+	}
+	b->rx_buf[b->rx_idx++] = val;
+	return 0;
+}
+
+static int mctp_i2c_target_stop(struct i2c_target_config *cfg)
+{
+	struct mctp_binding_i2c *b =
+		CONTAINER_OF(cfg, struct mctp_binding_i2c, target_cfg);
+
+	if (!b->rx_active) {
+		return 0;
+	}
+	b->rx_active = false;
+
+	if (b->rx_overflow) {
+		LOG_WRN("i2c rx: frame overflow, dropping");
+		return 0;
+	}
+
+	(void)mctp_i2c_input(b, b->rx_buf, b->rx_idx);
+	return 0;
+}
+
+/* MCTP-over-I2C never reads from the target; provide stubs the API requires. */
+static int mctp_i2c_target_read_requested(struct i2c_target_config *cfg,
+					  uint8_t *val)
+{
+	ARG_UNUSED(cfg);
+	*val = 0xFF;
+	return 0;
+}
+
+static int mctp_i2c_target_read_processed(struct i2c_target_config *cfg,
+					  uint8_t *val)
+{
+	ARG_UNUSED(cfg);
+	*val = 0xFF;
+	return 0;
+}
+
+const struct i2c_target_callbacks mctp_i2c_target_callbacks = {
+	.write_requested = mctp_i2c_target_write_requested,
+	.write_received = mctp_i2c_target_write_received,
+	.read_requested = mctp_i2c_target_read_requested,
+	.read_processed = mctp_i2c_target_read_processed,
+	.stop = mctp_i2c_target_stop,
+};
+
+/*
+ * Bring the binding up. With a real controller we also register as a target so
+ * the peer can write to us. In loopback mode (i2c == NULL) there is nothing to
+ * register; RX arrives via mctp_i2c_input() driven by the link_write hook.
+ */
+int mctp_i2c_start(struct mctp_binding *binding)
+{
+	struct mctp_binding_i2c *b = binding_to_i2c(binding);
+	int ret;
+
+	if (b->i2c != NULL) {
+		if (!device_is_ready(b->i2c)) {
+			LOG_ERR("i2c controller not ready");
+			return -ENODEV;
+		}
+		ret = i2c_target_register(b->i2c, &b->target_cfg);
+		if (ret != 0 && ret != -ENOSYS) {
+			LOG_ERR("i2c_target_register failed: %d", ret);
+			return ret;
+		}
+	}
+
+	mctp_binding_set_tx_enabled(binding, true);
+	return 0;
+}
+
+/*
+ * Transmit one MCTP packet as an SMBus block write. Builds
+ * [cmd][byte_count][src_addr][packet][PEC] into tx_buf and either invokes the
+ * link_write hook (loopback) or issues i2c_write() to the peer.
+ */
+int mctp_i2c_tx(struct mctp_binding *binding, struct mctp_pktbuf *pkt)
+{
+	struct mctp_binding_i2c *b = binding_to_i2c(binding);
+	size_t pkt_len = mctp_pktbuf_size(pkt);
+	size_t frame_len;
+	uint8_t byte_count;
+	uint8_t dest_wr;
+	uint8_t pec;
+
+	if (pkt_len == 0 || pkt_len > MCTP_I2C_MTU) {
+		LOG_ERR("i2c tx: bad packet len %zu", pkt_len);
+		return -EMSGSIZE;
+	}
+
+	/* byte_count = source-address byte + MCTP packet. */
+	byte_count = (uint8_t)(pkt_len + 1U);
+
+	b->tx_buf[0] = MCTP_I2C_COMMAND_CODE;
+	b->tx_buf[1] = byte_count;
+	b->tx_buf[2] = (uint8_t)((b->own_addr << 1) | 0x01);
+	memcpy(&b->tx_buf[3], mctp_pktbuf_hdr(pkt), pkt_len);
+
+	frame_len = pkt_len + 3U; /* cmd + byte_count + src + packet */
+
+	/* PEC = CRC-8 over dest write addr + frame so far. */
+	dest_wr = (uint8_t)(b->dest_addr << 1);
+	pec = mctp_i2c_pec(0, &dest_wr, 1);
+	pec = mctp_i2c_pec(pec, b->tx_buf, frame_len);
+	b->tx_buf[frame_len] = pec;
+	frame_len += 1U;
+
+	if (b->link_write != NULL) {
+		return b->link_write(b, b->tx_buf, frame_len);
+	}
+
+	if (b->i2c == NULL) {
+		LOG_ERR("i2c tx: no controller and no link hook");
+		return -ENODEV;
+	}
+
+	return i2c_write(b->i2c, b->tx_buf, frame_len, b->dest_addr);
+}
-- 
