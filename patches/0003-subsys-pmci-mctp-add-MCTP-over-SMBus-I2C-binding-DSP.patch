diff --git a/include/zephyr/pmci/mctp/mctp_i2c.h b/include/zephyr/pmci/mctp/mctp_i2c.h
new file mode 100644
index 00000000000..1947985f24e
--- /dev/null
+++ b/include/zephyr/pmci/mctp/mctp_i2c.h
@@ -0,0 +1,162 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_MCTP_I2C_H_
+#define ZEPHYR_MCTP_I2C_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <zephyr/drivers/i2c.h>
+#include <libmctp.h>
+
+/**
+ * @brief DSP0237 v1.2 — MCTP over SMBus/I2C transport binding.
+ *
+ * Every MCTP packet travels as an SMBus Block Write:
+ *
+ *   [ dst_addr<<1|W ] [ 0x0F ] [ byte_count ] [ src_addr<<1|1 ]
+ *       [ MCTP header + payload ] [ PEC ]
+ *
+ * The destination/write address and the trailing PEC are handled by the
+ * transport; @c byte_count counts the source-address byte plus the MCTP
+ * packet (i.e. everything between @c byte_count and @c PEC).  The PEC is an
+ * SMBus CRC-8 (poly 0x07, seed 0x00) taken over the receiver's write address
+ * followed by every byte up to but excluding the PEC.
+ *
+ * TX side:  the Zephyr guest is the bus controller and issues an
+ *           @c i2c_write() (SMBus block write) to the peer address.
+ * RX side:  the guest registers as an I2C target; the peer controller writes
+ *           a block to our address and the target callbacks reassemble it.
+ *
+ * On both paths the fully framed wire buffer is decoded by a single entry
+ * point, @ref mctp_i2c_input, so the framing/PEC logic can be exercised in a
+ * host loopback without an I2C controller that supports target mode.
+ */
+
+/** DSP0237 §6.3 — SMBus command code identifying an MCTP block write. */
+#define MCTP_I2C_COMMAND_CODE 0x0F
+
+/** Maximum MCTP packet body (header + payload) carried in one frame. */
+#define MCTP_I2C_MTU CONFIG_MCTP_I2C_MTU
+
+/*
+ * Framing overhead inside the i2c_write() payload: command code, byte count,
+ * source address and the trailing PEC.
+ */
+#define MCTP_I2C_FRAME_OVERHEAD 4U
+
+/** Largest wire frame handed to i2c_write() / seen by the target callbacks. */
+#define MCTP_I2C_MAX_FRAME (MCTP_I2C_MTU + MCTP_I2C_FRAME_OVERHEAD)
+
+/** @cond INTERNAL_HIDDEN */
+struct mctp_binding_i2c;
+/** INTERNAL_HIDDEN @endcond */
+
+/**
+ * @brief Optional link-layer write hook.
+ *
+ * When set, @ref mctp_i2c_tx calls this instead of @c i2c_write, handing over
+ * the fully framed SMBus block-write buffer (command code .. PEC). Used by the
+ * host loopback sample to shuttle frames straight into a peer's RX path; leave
+ * @c NULL to use the real I2C controller.
+ */
+typedef int (*mctp_i2c_link_write_fn)(struct mctp_binding_i2c *binding,
+				      const uint8_t *frame, size_t len);
+
+/**
+ * @brief MCTP over SMBus/I2C binding descriptor.
+ */
+struct mctp_binding_i2c {
+	/** @cond INTERNAL_HIDDEN */
+	struct mctp_binding binding;
+
+	/** I2C controller device (NULL in pure loopback mode). */
+	const struct device *i2c;
+
+	/** Target registration used to receive peer block writes. */
+	struct i2c_target_config target_cfg;
+
+	/** Our own 7-bit I2C address (target-receiver address). */
+	uint8_t own_addr;
+
+	/** Peer's 7-bit I2C address (block-write destination). */
+	uint8_t dest_addr;
+
+	/** Optional TX hook; when NULL, i2c_write() is used. */
+	mctp_i2c_link_write_fn link_write;
+
+	/** User context for @ref link_write (e.g. the loopback peer). */
+	void *link_ctx;
+
+	/** Staging buffer for the outgoing wire frame. */
+	uint8_t tx_buf[MCTP_I2C_MAX_FRAME];
+
+	/** Reassembly buffer for an incoming block write. */
+	uint8_t rx_buf[MCTP_I2C_MAX_FRAME];
+
+	/** Number of bytes accumulated in @c rx_buf. */
+	size_t rx_idx;
+
+	/** Whether an addressed write is currently in progress. */
+	bool rx_active;
+
+	/** Whether @c rx_buf overflowed and the frame must be dropped. */
+	bool rx_overflow;
+	/** INTERNAL_HIDDEN @endcond */
+};
+
+/** @cond INTERNAL_HIDDEN */
+int mctp_i2c_start(struct mctp_binding *binding);
+int mctp_i2c_tx(struct mctp_binding *binding, struct mctp_pktbuf *pkt);
+
+extern const struct i2c_target_callbacks mctp_i2c_target_callbacks;
+/** INTERNAL_HIDDEN @endcond */
+
+/**
+ * @brief Feed a complete DSP0237 wire frame into the binding's RX path.
+ *
+ * @param binding  Binding whose bus this frame arrived on.
+ * @param frame    Block-write body: command code, byte count, source address,
+ *                 MCTP packet and PEC.
+ * @param len      Length of @p frame in bytes.
+ *
+ * @return 0 on success and after the MCTP packet is delivered upward, or a
+ *         negative errno if the frame is malformed or fails PEC.
+ */
+int mctp_i2c_input(struct mctp_binding_i2c *binding, const uint8_t *frame,
+		   size_t len);
+
+/**
+ * @brief Statically define an MCTP over SMBus/I2C binding.
+ *
+ * @param _name  Symbolic name of the binding variable.
+ * @param _i2c   Pointer to the I2C controller @c device (NULL for loopback).
+ * @param _own   Our own 7-bit I2C (target) address.
+ * @param _dest  Peer's 7-bit I2C address for block writes.
+ */
+#define MCTP_I2C_DEFINE(_name, _i2c, _own, _dest)                              \
+	struct mctp_binding_i2c _name = {                                      \
+		.binding = {                                                   \
+			.name = STRINGIFY(_name),                             \
+			.version = 1,                                         \
+			.pkt_size = MCTP_PACKET_SIZE(MCTP_BTU),               \
+			.pkt_header = 0,                                      \
+			.pkt_trailer = 0,                                     \
+			.start = mctp_i2c_start,                             \
+			.tx = mctp_i2c_tx,                                   \
+		},                                                            \
+		.i2c = (_i2c),                                                \
+		.own_addr = (_own),                                           \
+		.dest_addr = (_dest),                                         \
+		.target_cfg = {                                               \
+			.address = (_own),                                   \
+			.callbacks = &mctp_i2c_target_callbacks,             \
+		},                                                            \
+	}
+
+#endif /* ZEPHYR_MCTP_I2C_H_ */
