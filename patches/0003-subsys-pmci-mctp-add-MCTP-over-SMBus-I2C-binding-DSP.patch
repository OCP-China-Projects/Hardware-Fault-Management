diff --git a/samples/subsys/pmci/pldm/i2c_loopback/src/main.c b/samples/subsys/pmci/pldm/i2c_loopback/src/main.c
new file mode 100644
index 00000000000..4c967b55214
--- /dev/null
+++ b/samples/subsys/pmci/pldm/i2c_loopback/src/main.c
@@ -0,0 +1,134 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * PLDM Type 0 over the standard DSP0237 MCTP-over-SMBus/I2C binding.
+ *
+ * Two real struct mctp_binding_i2c instances are wired together through the
+ * binding's link_write hook: whatever one side would put on the wire as an
+ * SMBus block write (command code 0x0F, byte count, source address, MCTP
+ * packet, PEC) is handed verbatim to the peer's mctp_i2c_input(), which runs
+ * the exact framing/PEC decode the real I2C target path uses. This exercises
+ * the full DSP0237 wire format plus the whole PLDM stack without needing an
+ * I2C controller that supports target mode.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/util.h>
+
+#include <libmctp.h>
+#include <libpldm/base.h>
+#include <libpldm/pldm_types.h>
+
+#include <zephyr/pmci/mctp/mctp_i2c.h>
+#include <zephyr/pmci/pldm/pldm.h>
+#include <zephyr/pmci/pldm/pldm_base.h>
+
+LOG_MODULE_REGISTER(sample, LOG_LEVEL_INF);
+
+#define EID_REQUESTER 0x10
+#define EID_RESPONDER 0x20
+
+#define I2C_ADDR_REQUESTER 0x30
+#define I2C_ADDR_RESPONDER 0x31
+
+/* i2c == NULL: pure loopback, RX is driven by the link_write hook below. */
+MCTP_I2C_DEFINE(bind_req, NULL, I2C_ADDR_REQUESTER, I2C_ADDR_RESPONDER);
+MCTP_I2C_DEFINE(bind_resp, NULL, I2C_ADDR_RESPONDER, I2C_ADDR_REQUESTER);
+
+/*
+ * Deliver a framed block write into the peer binding's decode path. The peer's
+ * own_addr must match this binding's dest_addr for the PEC (computed over the
+ * destination write address) to verify — which is exactly how the two static
+ * addresses above are paired.
+ */
+static int loopback_link_write(struct mctp_binding_i2c *from,
+			       const uint8_t *frame, size_t len)
+{
+	struct mctp_binding_i2c *peer = from->link_ctx;
+
+	return mctp_i2c_input(peer, frame, len);
+}
+
+static struct mctp *mctp_req, *mctp_resp;
+static struct pldm_ctx ctx_req, ctx_resp;
+
+int main(void)
+{
+	uint8_t types[8] = { 0 };
+	uint8_t tid = 0;
+	ver32_t ver;
+	int rc;
+
+	mctp_set_alloc_ops(malloc, free, realloc);
+
+	mctp_req = mctp_init();
+	mctp_resp = mctp_init();
+	if (mctp_req == NULL || mctp_resp == NULL) {
+		LOG_ERR("mctp_init failed");
+		return -1;
+	}
+
+	/* Cross-wire the two bindings' link hooks. */
+	bind_req.link_write = loopback_link_write;
+	bind_req.link_ctx = &bind_resp;
+	bind_resp.link_write = loopback_link_write;
+	bind_resp.link_ctx = &bind_req;
+
+	rc = mctp_register_bus(mctp_req, &bind_req.binding, EID_REQUESTER);
+	if (rc != 0) {
+		LOG_ERR("mctp_register_bus(req) rc=%d", rc);
+		return -1;
+	}
+	rc = mctp_register_bus(mctp_resp, &bind_resp.binding, EID_RESPONDER);
+	if (rc != 0) {
+		LOG_ERR("mctp_register_bus(resp) rc=%d", rc);
+		return -1;
+	}
+
+	rc = pldm_ctx_init(&ctx_req, mctp_req, EID_REQUESTER);
+	if (rc != 0) {
+		LOG_ERR("pldm_ctx_init(req) rc=%d", rc);
+		return -1;
+	}
+	rc = pldm_ctx_init(&ctx_resp, mctp_resp, EID_RESPONDER);
+	if (rc != 0) {
+		LOG_ERR("pldm_ctx_init(resp) rc=%d", rc);
+		return -1;
+	}
+	rc = pldm_base_responder_register(&ctx_resp);
+	if (rc != 0) {
+		LOG_ERR("pldm_base_responder_register rc=%d", rc);
+		return -1;
+	}
+
+	rc = pldm_base_get_tid_sync(&ctx_req, EID_RESPONDER, &tid);
+	if (rc != 0) {
+		LOG_ERR("GetTID rc=%d", rc);
+		return -1;
+	}
+	printk("GetTID -> 0x%02x\n", tid);
+
+	rc = pldm_base_get_types_sync(&ctx_req, EID_RESPONDER, types);
+	if (rc != 0) {
+		LOG_ERR("GetPLDMTypes rc=%d", rc);
+		return -1;
+	}
+	printk("GetPLDMTypes -> byte0=0x%02x\n", types[0]);
+
+	rc = pldm_base_get_version_sync(&ctx_req, EID_RESPONDER, PLDM_BASE, &ver);
+	if (rc != 0) {
+		LOG_ERR("GetPLDMVersion rc=%d", rc);
+		return -1;
+	}
+	printk("GetPLDMVersion(BASE) -> %u.%u.%u\n", ver.major & 0x0f,
+	       ver.minor & 0x0f, ver.update & 0x0f);
+
+	printk("PLDM over MCTP over I2C loopback OK\n");
+	return 0;
+}
