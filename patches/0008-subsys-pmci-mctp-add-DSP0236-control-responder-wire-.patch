new file mode 100644
index 00000000000..40f503e1df8
--- /dev/null
+++ b/include/zephyr/pmci/mctp/mctp_control.h
@@ -0,0 +1,93 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_PMCI_MCTP_MCTP_CONTROL_H_
+#define ZEPHYR_INCLUDE_PMCI_MCTP_MCTP_CONTROL_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <libmctp.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** MCTP message type for the control protocol (DSP0236 Table 1). */
+#define MCTP_MSG_TYPE_CTRL 0x00
+
+/**
+ * @file
+ * @brief MCTP control-protocol responder (DSP0236 §11) for a fixed-address
+ *        Zephyr endpoint.
+ *
+ * libmctp's core only dispatches transport-specific control commands
+ * (0xF0-0xFF) to a binding's @c control_rx callback; the baseline control
+ * commands (Set/Get Endpoint ID, Get MCTP Version Support, Get Message Type
+ * Support) fall through to the generic @c message_rx handler. A bus owner such
+ * as OpenBMC's mctpd must be able to run those commands against this node
+ * before it will publish it on D-Bus with the message types it supports, which
+ * in turn is what lets pldmd discover and poll this terminus.
+ *
+ * This responder installs itself as the MCTP receive callback, answers the
+ * baseline control requests for a statically-addressed endpoint, and forwards
+ * every other message to a downstream handler (typically the PLDM dispatcher).
+ */
+
+/**
+ * @brief State for the MCTP control responder.
+ *
+ * The endpoint EID is fixed at init time. Set Endpoint ID requests are only
+ * accepted when they match that EID (this node does not support dynamic EID
+ * reassignment, since libmctp exposes no public API to change the bus EID).
+ */
+struct mctp_control_ctx {
+	struct mctp *mctp;
+	mctp_eid_t local_eid;
+	const uint8_t *msg_types;
+	size_t num_msg_types;
+	mctp_rx_fn downstream;
+	void *downstream_data;
+};
+
+/**
+ * @brief Initialise the control responder and take over the MCTP RX callback.
+ *
+ * Registers @c mctp_control_rx() as the receive callback via
+ * @c mctp_set_rx_all(); baseline control requests are answered here and all
+ * other messages are forwarded to @p downstream. Call this after any downstream
+ * subsystem has been initialised, passing that subsystem's receive callback so
+ * this responder can chain to it.
+ *
+ * @param ctx             Responder state (must outlive the MCTP context).
+ * @param mctp            MCTP core the endpoint is bound to.
+ * @param eid             Fixed EID reported for this endpoint.
+ * @param msg_types       Array of MCTP message types this node supports
+ *                        (for Get Message Type Support), e.g. {0x01} for PLDM.
+ * @param num_msg_types   Number of entries in @p msg_types.
+ * @param downstream      Handler for non-control messages. May be NULL.
+ * @param downstream_data Opaque argument passed to @p downstream.
+ *
+ * @return 0 on success, negative errno otherwise.
+ */
+int mctp_control_responder_init(struct mctp_control_ctx *ctx, struct mctp *mctp,
+				mctp_eid_t eid, const uint8_t *msg_types,
+				size_t num_msg_types, mctp_rx_fn downstream,
+				void *downstream_data);
+
+/**
+ * @brief MCTP receive callback (matches @c mctp_rx_fn).
+ *
+ * Normally installed by @ref mctp_control_responder_init; exposed for tests.
+ */
+void mctp_control_rx(uint8_t src_eid, bool tag_owner, uint8_t msg_tag,
+		     void *data, void *msg, size_t len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_PMCI_MCTP_MCTP_CONTROL_H_ */
