diff --git a/subsys/pmci/mctp/mctp_control.c b/subsys/pmci/mctp/mctp_control.c
new file mode 100644
index 00000000000..9e478dfa5f4
--- /dev/null
+++ b/subsys/pmci/mctp/mctp_control.c
@@ -0,0 +1,254 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * MCTP control-protocol responder (DMTF DSP0236 §11) for a statically
+ * addressed endpoint.
+ *
+ * libmctp's core dispatches only transport-specific control commands
+ * (0xF0-0xFF) to a binding's control_rx callback; the baseline control
+ * commands land on the generic message_rx handler. A bus owner such as
+ * OpenBMC's mctpd runs Get Endpoint ID, (optionally) Set Endpoint ID and
+ * Get Message Type Support against a node before publishing it on D-Bus.
+ * pldmd's MctpDiscovery only picks up endpoints whose SupportedMessageTypes
+ * include PLDM (type 1), so answering these commands is what lets the BMC
+ * discover and poll this terminus.
+ *
+ * MCTP message framing follows libmctp's convention: the first byte of the
+ * message body is the MCTP message type (0x00 for control), matching the
+ * PLDM path (byte 0 == 0x01).
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+
+#include <libmctp.h>
+#include <libmctp-cmds.h>
+
+#include <zephyr/pmci/mctp/mctp_control.h>
+
+LOG_MODULE_REGISTER(mctp_control, CONFIG_MCTP_LOG_LEVEL);
+
+/* MCTP control message type (DSP0236 Table 1); MCTP_MSG_TYPE_CTRL in the API. */
+#define MCTP_MSG_TYPE_CONTROL MCTP_MSG_TYPE_CTRL
+
+/* Rq/D/Instance-ID byte (DSP0236 §11.4): bit7 Rq, bit6 D, bits4:0 instance. */
+#define CTRL_RESP_RQ_CLEAR 0x00
+
+/* Set Endpoint ID response status: assignment accepted, no EID pool. */
+#define SET_EID_STATUS_ACCEPTED 0x00
+
+/*
+ * Byte offsets into the MCTP message body (type byte + control header +
+ * payload). See DSP0236 §11.4.
+ */
+#define OFF_MSG_TYPE     0U
+#define OFF_RQ_DGRAM     1U
+#define OFF_CMD_CODE     2U
+#define OFF_CTRL_PAYLOAD 3U
+
+#define CTRL_HDR_LEN OFF_CTRL_PAYLOAD
+
+/*
+ * Fill the control-response header into @buf and transmit @len bytes (message
+ * type + control header + payload) back to @src. The caller fills the payload.
+ */
+static void ctrl_send(struct mctp_control_ctx *ctx, mctp_eid_t src,
+		      uint8_t msg_tag, uint8_t iid, uint8_t cmd, uint8_t *buf,
+		      size_t len)
+{
+	int rc;
+
+	buf[OFF_MSG_TYPE] = MCTP_MSG_TYPE_CONTROL;
+	buf[OFF_RQ_DGRAM] = CTRL_RESP_RQ_CLEAR |
+			    (iid & MCTP_CTRL_HDR_INSTANCE_ID_MASK);
+	buf[OFF_CMD_CODE] = cmd;
+
+	rc = mctp_message_tx(ctx->mctp, src, MCTP_MESSAGE_TO_SRC, msg_tag, buf,
+			     len);
+	if (rc != 0) {
+		LOG_WRN("control cmd 0x%02x tx failed: %d", cmd, rc);
+	}
+}
+
+static void ctrl_send_cc(struct mctp_control_ctx *ctx, mctp_eid_t src,
+			 uint8_t msg_tag, uint8_t iid, uint8_t cmd, uint8_t cc)
+{
+	uint8_t buf[CTRL_HDR_LEN + 1];
+
+	buf[OFF_CTRL_PAYLOAD] = cc;
+	ctrl_send(ctx, src, msg_tag, iid, cmd, buf, sizeof(buf));
+}
+
+static void handle_set_eid(struct mctp_control_ctx *ctx, mctp_eid_t src,
+			   uint8_t msg_tag, uint8_t iid, const uint8_t *msg,
+			   size_t len)
+{
+	/* payload: operation (1) + requested EID (1) */
+	uint8_t buf[CTRL_HDR_LEN + 4];
+	uint8_t req_eid;
+
+	if (len < OFF_CTRL_PAYLOAD + 2U) {
+		ctrl_send_cc(ctx, src, msg_tag, iid, MCTP_CTRL_CMD_SET_ENDPOINT_ID,
+			     MCTP_CTRL_CC_ERROR_INVALID_LENGTH);
+		return;
+	}
+
+	req_eid = msg[OFF_CTRL_PAYLOAD + 1U];
+
+	/*
+	 * This endpoint has a fixed EID (libmctp offers no public API to change
+	 * the bus EID at runtime). Accept only a matching or "no-change" (0)
+	 * request; reject anything else with invalid data.
+	 */
+	if (req_eid != 0 && req_eid != ctx->local_eid) {
+		LOG_WRN("Set EID %u rejected (fixed EID %u)", req_eid,
+			ctx->local_eid);
+		ctrl_send_cc(ctx, src, msg_tag, iid,
+			     MCTP_CTRL_CMD_SET_ENDPOINT_ID,
+			     MCTP_CTRL_CC_ERROR_INVALID_DATA);
+		return;
+	}
+
+	buf[OFF_CTRL_PAYLOAD + 0U] = MCTP_CTRL_CC_SUCCESS;
+	buf[OFF_CTRL_PAYLOAD + 1U] = SET_EID_STATUS_ACCEPTED;
+	buf[OFF_CTRL_PAYLOAD + 2U] = ctx->local_eid;
+	buf[OFF_CTRL_PAYLOAD + 3U] = 0; /* EID pool size: none */
+	ctrl_send(ctx, src, msg_tag, iid, MCTP_CTRL_CMD_SET_ENDPOINT_ID, buf,
+		  sizeof(buf));
+}
+
+static void handle_get_eid(struct mctp_control_ctx *ctx, mctp_eid_t src,
+			   uint8_t msg_tag, uint8_t iid)
+{
+	uint8_t buf[CTRL_HDR_LEN + 4];
+
+	buf[OFF_CTRL_PAYLOAD + 0U] = MCTP_CTRL_CC_SUCCESS;
+	buf[OFF_CTRL_PAYLOAD + 1U] = ctx->local_eid;
+	buf[OFF_CTRL_PAYLOAD + 2U] = 0; /* endpoint type: simple, dynamic EID */
+	buf[OFF_CTRL_PAYLOAD + 3U] = 0; /* medium-specific info */
+	ctrl_send(ctx, src, msg_tag, iid, MCTP_CTRL_CMD_GET_ENDPOINT_ID, buf,
+		  sizeof(buf));
+}
+
+static void handle_get_version(struct mctp_control_ctx *ctx, mctp_eid_t src,
+			       uint8_t msg_tag, uint8_t iid)
+{
+	/* completion_code + entry_count + one 4-byte version entry */
+	uint8_t buf[CTRL_HDR_LEN + 2 + 4];
+
+	buf[OFF_CTRL_PAYLOAD + 0U] = MCTP_CTRL_CC_SUCCESS;
+	buf[OFF_CTRL_PAYLOAD + 1U] = 1; /* number of version entries */
+	/* MCTP base spec version 1.3.1, packed BCD with 0xF filler nibble. */
+	buf[OFF_CTRL_PAYLOAD + 2U] = 0xF1; /* major 1 */
+	buf[OFF_CTRL_PAYLOAD + 3U] = 0xF3; /* minor 3 */
+	buf[OFF_CTRL_PAYLOAD + 4U] = 0xF1; /* update 1 */
+	buf[OFF_CTRL_PAYLOAD + 5U] = 0x00; /* alpha: none */
+	ctrl_send(ctx, src, msg_tag, iid, MCTP_CTRL_CMD_GET_VERSION_SUPPORT, buf,
+		  sizeof(buf));
+}
+
+static void handle_get_msg_types(struct mctp_control_ctx *ctx, mctp_eid_t src,
+				 uint8_t msg_tag, uint8_t iid)
+{
+	uint8_t buf[CTRL_HDR_LEN + 2 + CONFIG_MCTP_CONTROL_MAX_MSG_TYPES];
+	size_t n = ctx->num_msg_types;
+
+	if (n > CONFIG_MCTP_CONTROL_MAX_MSG_TYPES) {
+		n = CONFIG_MCTP_CONTROL_MAX_MSG_TYPES;
+	}
+
+	buf[OFF_CTRL_PAYLOAD + 0U] = MCTP_CTRL_CC_SUCCESS;
+	buf[OFF_CTRL_PAYLOAD + 1U] = (uint8_t)n;
+	for (size_t i = 0; i < n; i++) {
+		buf[OFF_CTRL_PAYLOAD + 2U + i] = ctx->msg_types[i];
+	}
+	ctrl_send(ctx, src, msg_tag, iid, MCTP_CTRL_CMD_GET_MESSAGE_TYPE_SUPPORT,
+		  buf, OFF_CTRL_PAYLOAD + 2U + n);
+}
+
+void mctp_control_rx(uint8_t src_eid, bool tag_owner, uint8_t msg_tag,
+		     void *data, void *msg, size_t len)
+{
+	struct mctp_control_ctx *ctx = data;
+	const uint8_t *buf = msg;
+	uint8_t rq_dgram, iid, cmd;
+
+	if (ctx == NULL || buf == NULL || len < CTRL_HDR_LEN) {
+		goto forward;
+	}
+
+	/* Only baseline control-protocol requests are handled here. */
+	if (buf[OFF_MSG_TYPE] != MCTP_MSG_TYPE_CONTROL) {
+		goto forward;
+	}
+
+	rq_dgram = buf[OFF_RQ_DGRAM];
+	if (!(rq_dgram & MCTP_CTRL_HDR_FLAG_REQUEST)) {
+		/* A control response; nothing to do for a pure responder. */
+		return;
+	}
+
+	iid = rq_dgram & MCTP_CTRL_HDR_INSTANCE_ID_MASK;
+	cmd = buf[OFF_CMD_CODE];
+
+	switch (cmd) {
+	case MCTP_CTRL_CMD_SET_ENDPOINT_ID:
+		handle_set_eid(ctx, src_eid, msg_tag, iid, buf, len);
+		return;
+	case MCTP_CTRL_CMD_GET_ENDPOINT_ID:
+		handle_get_eid(ctx, src_eid, msg_tag, iid);
+		return;
+	case MCTP_CTRL_CMD_GET_VERSION_SUPPORT:
+		handle_get_version(ctx, src_eid, msg_tag, iid);
+		return;
+	case MCTP_CTRL_CMD_GET_MESSAGE_TYPE_SUPPORT:
+		handle_get_msg_types(ctx, src_eid, msg_tag, iid);
+		return;
+	default:
+		LOG_DBG("unsupported control cmd 0x%02x from EID %u", cmd,
+			src_eid);
+		ctrl_send_cc(ctx, src_eid, msg_tag, iid, cmd,
+			     MCTP_CTRL_CC_ERROR_UNSUPPORTED_CMD);
+		return;
+	}
+
+forward:
+	if (ctx != NULL && ctx->downstream != NULL) {
+		ctx->downstream(src_eid, tag_owner, msg_tag,
+				ctx->downstream_data, msg, len);
+	}
+}
+
+int mctp_control_responder_init(struct mctp_control_ctx *ctx, struct mctp *mctp,
+				mctp_eid_t eid, const uint8_t *msg_types,
+				size_t num_msg_types, mctp_rx_fn downstream,
+				void *downstream_data)
+{
+	int rc;
+
+	if (ctx == NULL || mctp == NULL) {
+		return -EINVAL;
+	}
+	if (num_msg_types > 0 && msg_types == NULL) {
+		return -EINVAL;
+	}
+
+	ctx->mctp = mctp;
+	ctx->local_eid = eid;
+	ctx->msg_types = msg_types;
+	ctx->num_msg_types = num_msg_types;
+	ctx->downstream = downstream;
+	ctx->downstream_data = downstream_data;
+
+	rc = mctp_set_rx_all(mctp, mctp_control_rx, ctx);
+	if (rc != 0) {
+		return rc;
+	}
+
+	return 0;
+}
