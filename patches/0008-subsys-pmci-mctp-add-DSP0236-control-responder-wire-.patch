 #include <stdlib.h>
@@ -22,10 +29,17 @@
 #include <zephyr/logging/log.h>
 
 #include <libmctp.h>
+#include <libpldm/base.h>
+#include <libpldm/pldm_types.h>
 
 #include <zephyr/pmci/mctp/mctp_serial.h>
+#include <zephyr/pmci/mctp/mctp_control.h>
 #include <zephyr/pmci/pldm/pldm.h>
 #include <zephyr/pmci/pldm/pldm_base.h>
+#if defined(CONFIG_PLDM_TYPE_PLATFORM)
+#include <zephyr/pmci/pldm/pldm_platform.h>
+#include <libpldm/platform.h>
+#endif
 
 LOG_MODULE_REGISTER(serial_bridge, LOG_LEVEL_INF);
 
@@ -33,11 +47,135 @@ LOG_MODULE_REGISTER(serial_bridge, LOG_LEVEL_INF);
 #define LOCAL_EID 18
 #define BMC_EID   8
 
+/*
+ * Give the BMC time to boot pldmd, then retry GetTID until it answers. The BMC
+ * only brings up its MCTP link / route late in the two-QEMU harness, so keep
+ * retrying for several minutes.
+ */
+#define PROBE_START_DELAY_MS 5000
+#define PROBE_RETRY_MS       3000
+#define PROBE_MAX_TRIES      200
+
 static struct mctp *mctp_ctx;
 static struct pldm_ctx pldm;
+static struct mctp_control_ctx mctp_control;
+
+/* MCTP message types this endpoint answers to (DSP0236 Table 1). */
+static const uint8_t supported_msg_types[] = {
+	MCTP_MSG_TYPE_CTRL,
+	PLDM_MCTP_MSG_TYPE,
+};
 
 MCTP_SERIAL_DT_DEFINE(mctp_link, DEVICE_DT_GET(DT_NODELABEL(uart1)));
 
+/*
+ * Reverse-direction probe: query the BMC (EID 8) from this node. Runs in a
+ * dedicated thread so the responder (serviced from the UART ISR) keeps
+ * working regardless of how long the BMC takes to come up.
+ */
+static void probe_bmc(void)
+{
+	uint8_t types[8] = { 0 };
+	uint8_t tid = 0;
+	ver32_t ver;
+	int rc;
+	int i;
+
+	k_sleep(K_MSEC(PROBE_START_DELAY_MS));
+
+	for (i = 1; i <= PROBE_MAX_TRIES; i++) {
+		rc = pldm_base_get_tid_sync(&pldm, BMC_EID, &tid);
+		if (rc == 0) {
+			LOG_INF("BMC GetTID -> 0x%02x (try %d)", tid, i);
+			break;
+		}
+		LOG_WRN("BMC GetTID try %d rc=%d, retrying", i, rc);
+		k_sleep(K_MSEC(PROBE_RETRY_MS));
+	}
+
+	if (rc != 0) {
+		LOG_ERR("BMC did not answer GetTID after %d tries", PROBE_MAX_TRIES);
+		return;
+	}
+
+	rc = pldm_base_get_types_sync(&pldm, BMC_EID, types);
+	if (rc != 0) {
+		LOG_ERR("BMC GetPLDMTypes rc=%d", rc);
+	} else {
+		LOG_INF("BMC GetPLDMTypes -> byte0=0x%02x", types[0]);
+	}
+
+	rc = pldm_base_get_version_sync(&pldm, BMC_EID, PLDM_BASE, &ver);
+	if (rc != 0) {
+		LOG_ERR("BMC GetPLDMVersion rc=%d", rc);
+	} else {
+		LOG_INF("BMC GetPLDMVersion(BASE) -> %u.%u.%u", ver.major & 0x0f,
+			ver.minor & 0x0f, ver.update & 0x0f);
+	}
+
+	LOG_INF("Reverse-direction PLDM probe to BMC complete");
+}
+
+K_THREAD_DEFINE(probe_tid, 2048, probe_bmc, NULL, NULL, NULL,
+		K_LOWEST_APPLICATION_THREAD_PRIO, 0, -1);
+
+#if defined(CONFIG_PLDM_TYPE_PLATFORM)
+/* DSP0249 entity type for a temperature sensor (0x002B). */
+#define TEMP_ENTITY_TYPE 0x002B
+#define TEMP_SENSOR_ID	 1
+
+/*
+ * Simulated die-temperature source: a slow triangular sweep between 30 and
+ * 80 C so a polling management controller sees the reading move. The raw
+ * value is degrees C (unit modifier 0), matching the advertised PDR.
+ */
+static int read_die_temp(const struct pldm_platform_sensor *sensor,
+			 int32_t *reading)
+{
+	static int32_t value = 30;
+	static int32_t step = 1;
+
+	ARG_UNUSED(sensor);
+
+	value += step;
+	if (value >= 80 || value <= 30) {
+		step = -step;
+	}
+	*reading = value;
+	return 0;
+}
+
+static const struct pldm_platform_sensor die_temp_sensor = {
+	.sensor_id = TEMP_SENSOR_ID,
+	.entity_type = TEMP_ENTITY_TYPE,
+	.entity_instance = 1,
+	.base_unit = PLDM_SENSOR_UNIT_DEGRESS_C,
+	.unit_modifier = 0,
+	.read = read_die_temp,
+};
+
+static int platform_responder_setup(void)
+{
+	int rc;
+
+	rc = pldm_platform_add_numeric_sensor(&die_temp_sensor);
+	if (rc != 0) {
+		LOG_ERR("pldm_platform_add_numeric_sensor rc=%d", rc);
+		return rc;
+	}
+
+	rc = pldm_platform_responder_register(&pldm);
+	if (rc != 0) {
+		LOG_ERR("pldm_platform_responder_register rc=%d", rc);
+		return rc;
+	}
+
+	LOG_INF("Type 2 responder ready; sensor %d (temperature) exposed via PDR",
+		TEMP_SENSOR_ID);
+	return 0;
+}
+#endif /* CONFIG_PLDM_TYPE_PLATFORM */
+
 int main(void)
 {
 	int rc;
@@ -71,10 +209,35 @@ int main(void)
 		return -1;
 	}
 
+#if defined(CONFIG_PLDM_TYPE_PLATFORM)
+	rc = platform_responder_setup();
+	if (rc != 0) {
+		return -1;
+	}
+#endif
+
+	/*
+	 * Take over the MCTP receive callback to answer the baseline control
