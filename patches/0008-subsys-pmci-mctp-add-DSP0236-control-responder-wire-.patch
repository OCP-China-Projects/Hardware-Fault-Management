+					 supported_msg_types,
+					 ARRAY_SIZE(supported_msg_types),
+					 pldm_ctx_rx, &pldm);
+	if (rc != 0) {
+		LOG_ERR("mctp_control_responder_init rc=%d", rc);
+		return -1;
+	}
+
 	/* Enable UART interrupts and start feeding the DSP0253 decoder. */
 	mctp_serial_start_rx(&mctp_link);
 
