diff --git a/include/zephyr/pmci/pldm/pldm.h b/include/zephyr/pmci/pldm/pldm.h
new file mode 100644
index 00000000000..9db0ac85084
--- /dev/null
+++ b/include/zephyr/pmci/pldm/pldm.h
@@ -0,0 +1,149 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_H_
+#define ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <zephyr/kernel.h>
+#include <libmctp.h>
+#include <libpldm/base.h>
+#include <libpldm/pldm_types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @file
+ * @brief Zephyr PLDM (DSP0240) subsystem over MCTP.
+ *
+ * The subsystem multiplexes PLDM traffic on top of the MCTP message-type
+ * byte (0x01, DSP0240 §4.1). Each PLDM type registers a handler and is
+ * dispatched by pldm.c; requesters allocate an instance-id from a pool
+ * and block on a per-request completion semaphore until the response
+ * arrives.
+ */
+
+/** MCTP message type for PLDM as per DSP0240 Table 1. */
+#define PLDM_MCTP_MSG_TYPE 0x01
+
+struct pldm_ctx;
+
+/**
+ * @brief Responder handler for a single PLDM type.
+ *
+ * @param ctx        Context that received the request.
+ * @param src_eid    Source EID of the requester (MCTP layer).
+ * @param req        Request message (header + payload, no MCTP type byte).
+ * @param req_len    Length of @p req in bytes.
+ * @param resp       Buffer to fill with the response (header + payload).
+ * @param resp_size  Capacity of @p resp on entry.
+ * @param resp_len   Actual response length on exit.
+ *
+ * @return 0 on success. On failure return a negative errno; the core will
+ *         synthesise a CC-only response using the appropriate PLDM
+ *         completion code.
+ */
+typedef int (*pldm_type_handler_fn)(struct pldm_ctx *ctx, uint8_t src_eid,
+				    const struct pldm_msg *req, size_t req_len,
+				    struct pldm_msg *resp, size_t resp_size,
+				    size_t *resp_len);
+
+/**
+ * @brief Per-endpoint PLDM state.
+ *
+ * One @ref pldm_ctx corresponds to a single MCTP endpoint. The subsystem
+ * hooks into libmctp via mctp_set_rx_all() so all PLDM traffic destined
+ * for the local EID lands in @ref pldm_ctx_rx().
+ */
+struct pldm_ctx {
+	struct mctp *mctp;
+	mctp_eid_t local_eid;
+
+#if defined(CONFIG_PLDM_RESPONDER)
+	pldm_type_handler_fn handlers[PLDM_MAX_TYPES];
+#endif
+
+#if defined(CONFIG_PLDM_REQUESTER)
+	struct k_mutex req_lock;
+	struct k_sem req_slot_sem;
+	struct pldm_request_slot {
+		bool used;
+		uint8_t instance_id;
+		uint8_t pldm_type;
+		uint8_t command;
+		mctp_eid_t peer_eid;
+		struct k_sem done;
+		uint8_t resp_buf[CONFIG_PLDM_REQUESTER_MAX_PAYLOAD];
+		size_t resp_len;
+		int rc;
+	} slots[CONFIG_PLDM_MAX_INSTANCES];
+#endif
+};
+
+/**
+ * @brief Initialise a PLDM context bound to an MCTP endpoint.
+ *
+ * Registers @c pldm_ctx_rx() as the MCTP receive callback for @p mctp.
+ * The caller is expected to have already registered a binding with the
+ * MCTP core via mctp_register_bus().
+ *
+ * @return 0 on success, negative errno otherwise.
+ */
+int pldm_ctx_init(struct pldm_ctx *ctx, struct mctp *mctp, mctp_eid_t eid);
+
+/**
+ * @brief Feed one MCTP message into the PLDM dispatcher.
+ *
+ * Wired to libmctp's @c mctp_rx_fn signature; users normally never call
+ * this directly. Exposed for unit tests and for loopback plumbing.
+ */
+void pldm_ctx_rx(uint8_t src_eid, bool tag_owner, uint8_t msg_tag, void *data,
+		 void *msg, size_t len);
+
+#if defined(CONFIG_PLDM_RESPONDER)
+/**
+ * @brief Register a responder handler for a single PLDM type.
+ *
+ * @param pldm_type One of @ref pldm_supported_types.
+ * @param fn        Handler invoked for every request targeting @p pldm_type.
+ *
+ * @return 0 on success, -EINVAL if the type is out of range, -EEXIST if a
+ *         handler for @p pldm_type is already registered.
+ */
+int pldm_register_type(struct pldm_ctx *ctx, uint8_t pldm_type,
+		       pldm_type_handler_fn fn);
+#endif
+
+#if defined(CONFIG_PLDM_REQUESTER)
+/**
+ * @brief Send a PLDM request and block until a response arrives.
+ *
+ * @param ctx       Local PLDM context.
+ * @param peer_eid  Destination EID (must have a route via the MCTP core).
+ * @param pldm_type Value copied into the PLDM header @c type field.
+ * @param command   Value copied into the PLDM header @c command field.
+ * @param req_body  Payload following the PLDM header. May be NULL.
+ * @param req_len   Length of @p req_body.
+ * @param resp_buf  Buffer receiving the full response (header + payload).
+ * @param resp_size Capacity of @p resp_buf.
+ * @param resp_len  On success, the number of bytes written into @p resp_buf.
+ *
+ * @return 0 on success. Negative errno on transport / timeout failures.
+ */
+int pldm_send_request_sync(struct pldm_ctx *ctx, mctp_eid_t peer_eid,
+			   uint8_t pldm_type, uint8_t command,
+			   const void *req_body, size_t req_len,
+			   void *resp_buf, size_t resp_size, size_t *resp_len);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_H_ */
