+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_BASE_H_
+#define ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_BASE_H_
+
+#include <stdint.h>
+#include <zephyr/pmci/pldm/pldm.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @file
+ * @brief DSP0240 PLDM Type 0 (Messaging Control and Discovery) helpers.
+ */
+
+/**
+ * @brief Install the Type 0 responder into @p ctx.
+ *
+ * Registers a handler that services SetTID / GetTID / GetPLDMVersion /
+ * GetPLDMTypes / GetPLDMCommands. The initial TID is taken from
+ * @c CONFIG_PLDM_BASE_INITIAL_TID.
+ */
+int pldm_base_responder_register(struct pldm_ctx *ctx);
+
+/**
+ * @brief Retrieve the Terminus ID currently advertised by the responder.
+ */
+uint8_t pldm_base_get_tid(void);
+
+/**
+ * @brief Override the advertised Terminus ID (mirrors a SetTID from the wire).
+ */
+void pldm_base_set_tid(uint8_t tid);
+
+#if defined(CONFIG_PLDM_REQUESTER)
+/** Send GetTID and populate @p tid on success. */
+int pldm_base_get_tid_sync(struct pldm_ctx *ctx, mctp_eid_t peer,
+			   uint8_t *tid);
+
+/** Send GetPLDMTypes and populate @p types (bit N set => type N supported). */
+int pldm_base_get_types_sync(struct pldm_ctx *ctx, mctp_eid_t peer,
+			     uint8_t types[8]);
+
+/** Send GetPLDMVersion for one PLDM type and populate @p version. */
+int pldm_base_get_version_sync(struct pldm_ctx *ctx, mctp_eid_t peer,
+			       uint8_t pldm_type, ver32_t *version);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_PMCI_PLDM_PLDM_BASE_H_ */
