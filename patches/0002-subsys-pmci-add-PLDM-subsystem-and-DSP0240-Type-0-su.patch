diff --git a/samples/subsys/pmci/pldm/type0_loopback/src/main.c b/samples/subsys/pmci/pldm/type0_loopback/src/main.c
new file mode 100644
index 00000000000..09d287479cb
--- /dev/null
+++ b/samples/subsys/pmci/pldm/type0_loopback/src/main.c
@@ -0,0 +1,163 @@
+/*
+ * Copyright (c) 2026 OCP Hardware-Fault-Management project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * PLDM Type 0 end-to-end sample.
+ *
+ * Two MCTP endpoints share an in-process loopback binding: each binding's
+ * tx callback deposits the packet on its peer's rx path. The requester EID
+ * asks the responder EID for TID / supported types / base-type version.
+ * This exercises the entire PLDM stack (subsys/pmci/pldm) without needing
+ * a hardware transport.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/util.h>
+
+#include <libmctp.h>
+#include <libpldm/base.h>
+#include <libpldm/pldm_types.h>
+
+#include <zephyr/pmci/pldm/pldm.h>
+#include <zephyr/pmci/pldm/pldm_base.h>
+
+LOG_MODULE_REGISTER(sample, LOG_LEVEL_INF);
+
+#define EID_REQUESTER 0x10
+#define EID_RESPONDER 0x20
+
+struct loopback_binding {
+	struct mctp_binding binding;
+	struct mctp_binding *peer; /* target of every tx */
+};
+
+static int loopback_start(struct mctp_binding *b)
+{
+	mctp_binding_set_tx_enabled(b, true);
+	return 0;
+}
+
+/*
+ * Move a packet across to the peer binding. Note that libmctp expects the
+ * receiver to take ownership of the pktbuf, so we duplicate to avoid the
+ * original tx path double-freeing. mctp_pktbuf_alloc + mctp_pktbuf_push
+ * preserves the header byte alignment for the receiving core.
+ */
+static int loopback_tx(struct mctp_binding *b, struct mctp_pktbuf *pkt)
+{
+	struct loopback_binding *self =
+		CONTAINER_OF(b, struct loopback_binding, binding);
+	struct mctp_pktbuf *copy;
+	size_t sz = mctp_pktbuf_size(pkt);
+
+	copy = mctp_pktbuf_alloc(self->peer, 0);
+	if (copy == NULL) {
+		return -ENOMEM;
+	}
+	if (mctp_pktbuf_push(copy, mctp_pktbuf_hdr(pkt), sz) != 0) {
+		mctp_pktbuf_free(copy);
+		return -ENOMEM;
+	}
+	mctp_bus_rx(self->peer, copy);
+	return 0;
+}
+
+static void loopback_init(struct loopback_binding *lb, const char *name)
+{
+	memset(lb, 0, sizeof(*lb));
+	lb->binding.name = name;
+	lb->binding.version = 1;
+	lb->binding.pkt_size = MCTP_PACKET_SIZE(MCTP_BTU);
+	lb->binding.pkt_header = 0;
+	lb->binding.pkt_trailer = 0;
+	lb->binding.start = loopback_start;
+	lb->binding.tx = loopback_tx;
+}
+
+static struct mctp *mctp_req, *mctp_resp;
+static struct loopback_binding lb_req, lb_resp;
+static struct pldm_ctx ctx_req, ctx_resp;
+
+int main(void)
+{
+	uint8_t types[8] = { 0 };
+	uint8_t tid = 0;
+	ver32_t ver;
+	int rc;
+
+	mctp_set_alloc_ops(malloc, free, realloc);
+
+	mctp_req = mctp_init();
+	mctp_resp = mctp_init();
+	if (mctp_req == NULL || mctp_resp == NULL) {
+		LOG_ERR("mctp_init failed");
+		return -1;
+	}
+
+	loopback_init(&lb_req, "lb_req");
+	loopback_init(&lb_resp, "lb_resp");
+	lb_req.peer = &lb_resp.binding;
+	lb_resp.peer = &lb_req.binding;
+
+	rc = mctp_register_bus(mctp_req, &lb_req.binding, EID_REQUESTER);
+	if (rc != 0) {
+		LOG_ERR("mctp_register_bus(req) rc=%d", rc);
+		return -1;
+	}
+	rc = mctp_register_bus(mctp_resp, &lb_resp.binding, EID_RESPONDER);
+	if (rc != 0) {
+		LOG_ERR("mctp_register_bus(resp) rc=%d", rc);
+		return -1;
+	}
+
+	rc = pldm_ctx_init(&ctx_req, mctp_req, EID_REQUESTER);
+	if (rc != 0) {
+		LOG_ERR("pldm_ctx_init(req) rc=%d", rc);
+		return -1;
+	}
+	rc = pldm_ctx_init(&ctx_resp, mctp_resp, EID_RESPONDER);
+	if (rc != 0) {
+		LOG_ERR("pldm_ctx_init(resp) rc=%d", rc);
+		return -1;
+	}
+	rc = pldm_base_responder_register(&ctx_resp);
+	if (rc != 0) {
+		LOG_ERR("pldm_base_responder_register rc=%d", rc);
+		return -1;
+	}
+
+	rc = pldm_base_get_tid_sync(&ctx_req, EID_RESPONDER, &tid);
+	if (rc != 0) {
+		LOG_ERR("GetTID rc=%d", rc);
+		return -1;
+	}
+	printk("GetTID -> 0x%02x\n", tid);
+
+	rc = pldm_base_get_types_sync(&ctx_req, EID_RESPONDER, types);
+	if (rc != 0) {
+		LOG_ERR("GetPLDMTypes rc=%d", rc);
+		return -1;
+	}
+	printk("GetPLDMTypes -> byte0=0x%02x\n", types[0]);
+
+	rc = pldm_base_get_version_sync(&ctx_req, EID_RESPONDER, PLDM_BASE,
+					&ver);
+	if (rc != 0) {
+		LOG_ERR("GetPLDMVersion rc=%d", rc);
+		return -1;
+	}
+	/*
+	 * ver32_t stores each digit as a BCD-ish nibble; 0xf1 == "1", 0xf0 ==
+	 * "0". Print the interpretation the sample.yaml regex expects.
+	 */
+	printk("GetPLDMVersion(BASE) -> %u.%u.%u\n", ver.major & 0x0f,
+	       ver.minor & 0x0f, ver.update & 0x0f);
+
+	printk("PLDM Type 0 loopback OK\n");
+	return 0;
+}
