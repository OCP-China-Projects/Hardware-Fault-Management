# Zephyr / west build artifacts
build/
.west/
zephyr_project/

# Prebuilt binaries decompressed at runtime by launch_*.sh
prebuilts/*.elf
!prebuilts/*.elf.gz
prebuilts/*.mtd
!prebuilts/*.mtd.gz
# Backup copies of prebuilts kept while iterating
prebuilts/*-bak

# Python caches
__pycache__/
scripts/__pycache__/

# Editors / OS
*.swp
*~
.DS_Store
